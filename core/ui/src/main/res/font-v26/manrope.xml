<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/manrope_regular"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/manrope_regular" />

    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/manrope_medium"
        app:fontStyle="normal"
        app:fontWeight="500"
        app:font="@font/manrope_medium"
        tools:targetApi="26" />

    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/manrope_semibold"
        app:fontStyle="normal"
        app:fontWeight="600"
        app:font="@font/manrope_semibold"
        tools:targetApi="26" />
</font-family>